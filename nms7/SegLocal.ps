/redvalue {RedA gidx get RedA gidx 1 sub get
  RedA gidx get sub dgdxval mul add} def
/greenvalue {GreenA gidx get GreenA gidx 1 sub get
  GreenA gidx get sub dgdxval mul add} def
/bluevalue {BlueA gidx get BlueA gidx 1 sub get
  BlueA gidx get sub dgdxval mul add} def
/interpolate {
  grayindex grayv GrayA gidx get sub abs 1e-5 le
    {RedA gidx get GreenA gidx get BlueA gidx get}
    {/dgdxval dgdx def redvalue greenvalue bluevalue} ifelse} def
/GrayA [0 .25 .5 .75 1 ] def
/RedA [1 0 1 1 1 ] def
/GreenA [1 0 0 1 .7529 ] def
/BlueA [1 1 0 0 .7529 ] def
/pm3dround {maxcolors 0 gt {dup 1 ge
	{pop 1} {maxcolors mul floor maxcolors 1 sub div} ifelse} if} def
/pm3dGamma 1.0 1.5 Gamma mul div def
/ColorSpace (RGB) def
Color InterpolatedColor or { % COLOUR vs. GRAY map
  InterpolatedColor { %% Interpolation vs. RGB-Formula
    /g {stroke pm3dround /grayv exch def interpolate
        SelectSpace setrgbcolor} bind def
  }{
  /g {stroke pm3dround dup cF7 Constrain exch dup cF5 Constrain exch cF15 Constrain 
       SelectSpace setrgbcolor} bind def
  } ifelse
}{
  /g {stroke pm3dround pm3dGamma exp setgray} bind def
} ifelse
1.000 UL
LTb
LCb setrgbcolor
1.000 UL
LTB
LCb setrgbcolor
210 2380 N
210 168 L
1409 0 V
0 2212 V
-1409 0 V
Z stroke
1.000 UP
1.000 UL
LTb
LCb setrgbcolor
% Begin plot #1
1.000 UL
LTb
0.58 0.00 0.83 C
%%%%BeginImage
gsave 210 2380 N 210 168 L 1619 168 L 1619 2380 L Z clip
InterpretLevel1 {
  %% Construct a box instead of image
  LTb
  210 2380 M
  1409 0 V
  0 -2212 V
  -1409 0 V
  210 2380 L
  40 -110 R
  (PS level 2 image) Lshow
  % Read data but ignore it
  /imagebuf 65535 string def
  /imagebuf_rest 14285 string def
   1 1 1 { pop currentfile imagebuf readstring } for
  currentfile imagebuf_rest readstring
} {
gsave
210 2380 translate
1409 -2212 scale
